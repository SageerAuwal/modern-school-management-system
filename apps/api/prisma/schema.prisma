// Prisma Schema — School Management System
// Single source of truth for all database tables.
// Run `npm run prisma:generate` after changes.
// Run `npm run prisma:migrate` to apply changes to the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 0 — Foundation tables (SCHOOL + AUDIT_LOG)
// ─────────────────────────────────────────────────────────────────────────────

/// A single school — this system is single-tenant (one school only).
/// Captures all fields needed for government reporting (section 3.17 of PRD).
model School {
  id              String   @id @default(uuid())
  name            String
  emisId          String?  @unique @map("emis_id")
  examCenterNo    String?  @map("exam_center_no")
  gpsLat          Float?   @map("gps_lat")
  gpsLng          Float?   @map("gps_lng")
  lga             String?
  ward            String?
  district        String?
  state           String?
  ownershipType   String?  @map("ownership_type")
  operatingStatus String?  @map("operating_status")
  levelsOffered   String[] @map("levels_offered")
  address         String?
  phone           String?
  email           String?
  website         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users             User[]
  students          Student[]
  classSections     ClassSection[]
  staffRecords      StaffRecord[]
  attendanceRecords AttendanceRecord[]
  subjects          Subject[]
  terms             Term[]
  scores            Score[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]
  payments          Payment[]
  books             Book[]
  bookLoans         BookLoan[]
  buses             Bus[]
  transportRoutes   TransportRoute[]
  studentTransports StudentTransport[]
  timetables        Timetable[]
  clinicVisits      ClinicVisit[]
  clinicInventory   ClinicInventory[]
  medicationDispenses MedicationDispense[]
  immunizations     ImmunizationRecord[]
  classResultReleases ClassResultRelease[]
  dutyAssignments   TeacherDutyAssignment[]
  substitutions     TeacherSubstitution[]
  receiptSequence   ReceiptSequence?
  cashDrawers       DailyCashDrawer[]
  financialAuditLogs FinancialAuditLog[]

  @@map("schools")
}

/// Audit log — append-only, never deleted. Required by PRD 4.1.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actorEmail  String?  @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 1 — Auth & Roles
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  BURSAR
  TEACHER
  NURSE
  LIBRARIAN
  TRANSPORT_COORDINATOR
  PARENT
  STUDENT
}

/// System users — only portal-interacting roles get accounts.
model User {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  photoUrl     String?   @map("photo_url")
  isActive     Boolean   @default(true) @map("is_active")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  mfaSecret    String?   @map("mfa_secret")
  inviteToken  String?   @unique @map("invite_token")
  inviteExpiry DateTime? @map("invite_expiry")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  school           School         @relation(fields: [schoolId], references: [id])
  refreshTokens    RefreshToken[]
  taughtClasses    ClassSection[] @relation("ClassTeacher")
  markedAttendance AttendanceRecord[] @relation("AttendanceMarkedBy")
  editedAttendance AttendanceRecord[] @relation("AttendanceEditedBy")
  subjectClasses   ClassSubject[] @relation("SubjectTeacher")
  enteredScores    Score[]        @relation("ScoreEnteredBy")
  editedScores     Score[]        @relation("ScoreEditedBy")
  invoicesCreated  Invoice[]      @relation("InvoiceCreatedBy")
  paymentsRecorded Payment[]      @relation("PaymentRecordedBy")
  issuedLoans      BookLoan[]     @relation("LoanIssuedBy")
  returnedLoans    BookLoan[]     @relation("LoanReturnedBy")
  timetableLessons TimetableLesson[] @relation("TimetableTeacher")
  clinicVisitsLogged ClinicVisit[]   @relation("ClinicVisitLoggedBy")
  dispensationsGiven MedicationDispense[] @relation("MedicationDispensedBy")
  dutyAssignments    TeacherDutyAssignment[] @relation("TeacherDutyAssignments")
  absentSubstitutions TeacherSubstitution[] @relation("AbsentTeacherSubstitutions")
  substituteAssignments TeacherSubstitution[] @relation("SubstituteTeacherAssignments")
  cashDrawers        DailyCashDrawer[]       @relation("BursarCashDrawers")
  financialAuditLogs FinancialAuditLog[]     @relation("FinancialAuditLogs")

  @@index([schoolId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 2 — Students, Classes & Staff
// ─────────────────────────────────────────────────────────────────────────────

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  TRANSFERRED
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Student record — never hard-deleted, only status-flagged.
model Student {
  id               String           @id @default(uuid())
  schoolId         String           @map("school_id")
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  otherNames       String?          @map("other_names")
  dateOfBirth      DateTime?        @map("date_of_birth")
  gender           Gender?
  address          String?
  stateOfOrigin    String?          @map("state_of_origin")
  lga              String?
  religion         String?
  admissionNumber  String?          @unique @map("admission_number")
  enrollmentStatus EnrollmentStatus @default(ACTIVE) @map("enrollment_status")
  enrolledAt       DateTime         @default(now()) @map("enrolled_at")
  withdrawnAt      DateTime?        @map("withdrawn_at")
  photoUrl         String?          @map("photo_url")
  guardianName     String?          @map("guardian_name")
  guardianPhone    String?          @map("guardian_phone")
  guardianRelationship String?      @map("guardian_relationship")
  guardianPhotoUrl String?          @map("guardian_photo_url")
  bloodGroup           String?          @map("blood_group")
  genotype             String?          @map("genotype")
  allergies            String?          @map("allergies")
  chronicConditions    String?          @map("chronic_conditions")
  emergencyContactName String?          @map("emergency_contact_name")
  emergencyContactPhone String?         @map("emergency_contact_phone")
  medicalNotes         String?          @map("medical_notes")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  school               School           @relation(fields: [schoolId], references: [id])
  guardianLinks        GuardianLink[]
  enrollments          Enrollment[]
  attendanceRecords    AttendanceRecord[]
  scores               Score[]
  invoices             Invoice[]
  bookLoans            BookLoan[]
  transportAssignments StudentTransport[]
  clinicVisits         ClinicVisit[]
  immunizations        ImmunizationRecord[]
  dispensedMedicines   MedicationDispense[]

  @@index([schoolId])
  @@index([enrollmentStatus])
  @@index([admissionNumber])
  @@map("students")
}

/// Guardian-to-student link (many-to-many: one parent can have multiple children).
model GuardianLink {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  guardianId   String   @map("guardian_id") // USER with role PARENT
  relationship String?                       // mother, father, uncle, etc.
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("guardian_links")
}

/// A class section — e.g. "JSS 1A", "SS 2 Science".
model ClassSection {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String                         // e.g. "JSS 1A"
  level        String                         // e.g. "JSS1", "SS2"
  stream       String?                        // e.g. "Science", "Art", "Commercial"
  academicYear String   @map("academic_year") // e.g. "2025/2026"
  capacity     Int?                           // max students
  teacherId    String?  @map("teacher_id")    // Class teacher
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school            School       @relation(fields: [schoolId], references: [id])
  teacher           User?        @relation("ClassTeacher", fields: [teacherId], references: [id])
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  classSubjects     ClassSubject[]
  scores            Score[]
  timetableLessons  TimetableLesson[]
  resultReleases    ClassResultRelease[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId])
  @@index([academicYear])
  @@map("class_sections")
}

/// Student enrollment in a class section for a given academic year.
model Enrollment {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  classSectionId String           @map("class_section_id")
  academicYear   String           @map("academic_year")
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  exitedAt       DateTime?        @map("exited_at")
  exitReason     String?          @map("exit_reason") // e.g. TRANSFERRED, WITHDRAWN
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  @@unique([studentId, classSectionId, academicYear])
  @@index([studentId])
  @@index([classSectionId])
  @@index([academicYear])
  @@map("enrollments")
}

/// Lightweight record for support/facility staff (security, cleaners, drivers).
/// These staff do NOT get portal login accounts — they are HR records only.
model StaffRecord {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  role       String                        // e.g. "Security", "Cleaner", "Driver"
  phone      String?
  address    String?
  gender     Gender?
  photoUrl   String?   @map("photo_url")
  startDate  DateTime? @map("start_date")
  endDate    DateTime? @map("end_date")
  isActive   Boolean   @default(true) @map("is_active")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([isActive])
  @@map("staff_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 3 — Attendance
// ─────────────────────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One attendance record per student per class per date.
/// Always audited — edits require a reason and are logged.
model AttendanceRecord {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  classSectionId String           @map("class_section_id")
  studentId      String           @map("student_id")
  date           DateTime         @db.Date           // Date only — no time component
  status         AttendanceStatus
  note           String?                             // Optional teacher note / excuse reason
  markedById     String           @map("marked_by_id")
  editedById     String?          @map("edited_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  markedBy     User         @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  editedBy     User?        @relation("AttendanceEditedBy", fields: [editedById], references: [id])

  @@unique([studentId, classSectionId, date])
  @@index([schoolId, date])
  @@index([classSectionId, date])
  @@index([studentId])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 4 — Grading & Results
// ─────────────────────────────────────────────────────────────────────────────

/// An academic subject offered by the school (e.g. Mathematics, English).
model Subject {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  code        String?                   // Short code e.g. "MTH", "ENG"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school        School         @relation(fields: [schoolId], references: [id])
  classSubjects    ClassSubject[]
  scores           Score[]
  timetableLessons TimetableLesson[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

/// An academic term/semester (e.g. "First Term 2025/2026").
model Term {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String                    // "First Term", "Second Term", "Third Term"
  academicYear String   @map("academic_year") // "2025/2026"
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  isCurrent    Boolean  @default(false) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School  @relation(fields: [schoolId], references: [id])
  scores Score[]
  feeStructures FeeStructure[]
  invoices      Invoice[]
  timetables    Timetable[]
  resultReleases ClassResultRelease[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId])
  @@map("terms")
}

/// Links a subject to a class section — which subjects does each class offer?
/// Also records who the subject teacher is for that class.
model ClassSubject {
  id             String   @id @default(uuid())
  classSectionId String   @map("class_section_id")
  subjectId      String   @map("subject_id")
  teacherId      String?  @map("teacher_id")
  createdAt      DateTime @default(now()) @map("created_at")

  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      User?        @relation("SubjectTeacher", fields: [teacherId], references: [id])

  @@unique([classSectionId, subjectId])
  @@index([classSectionId])
  @@map("class_subjects")
}

/// Student score for one subject in one term.
/// CA components + exam score → auto-computed total + grade.
model Score {
  id             String  @id @default(uuid())
  schoolId       String  @map("school_id")
  studentId      String  @map("student_id")
  subjectId      String  @map("subject_id")
  classSectionId String  @map("class_section_id")
  termId         String  @map("term_id")
  academicYear   String  @map("academic_year")

  // Continuous Assessment components (max configurable — default 30 total)
  ca1   Float?  @map("ca1")
  ca2   Float?  @map("ca2")
  ca3   Float?  @map("ca3")

  // Examination score (max 70)
  exam  Float?

  // Computed fields (filled by service after entry)
  total   Float?
  grade   String?  // A, B, C, D, E, F
  remark  String?  // Excellent, Very Good, Good, Average, Below Average, Fail

  enteredById String  @map("entered_by_id")
  editedById  String? @map("edited_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  enteredBy    User         @relation("ScoreEnteredBy", fields: [enteredById], references: [id])
  editedBy     User?        @relation("ScoreEditedBy", fields: [editedById], references: [id])

  @@unique([studentId, subjectId, classSectionId, termId])
  @@index([studentId, termId])
  @@index([classSectionId, subjectId, termId])
  @@map("scores")
}

enum ResultReleaseStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  PUBLISHED
}

model ClassResultRelease {
  id              String              @id @default(uuid())
  schoolId        String              @map("school_id")
  classSectionId  String              @map("class_section_id")
  termId          String              @map("term_id")
  academicYear    String              @map("academic_year")
  status          ResultReleaseStatus @default(DRAFT)

  // Teacher Submission
  submittedById   String?             @map("submitted_by_id")
  submittedAt     DateTime?           @map("submitted_at")

  // Admin Audit, Approval & Principal Sign-Off
  approvedById    String?             @map("approved_by_id")
  approvedAt      DateTime?           @map("approved_at")
  principalRemark String?             @map("principal_remark")

  // Release / Publication Gate
  publishedById   String?             @map("published_by_id")
  publishedAt     DateTime?           @map("published_at")

  // Admin Revision Notes (if returned for corrections)
  revisionNotes   String?             @map("revision_notes")

  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  @@unique([classSectionId, termId])
  @@index([schoolId, termId])
  @@map("class_result_releases")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 5 — Fee Management & Payments
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  PAYSTACK     // Online via Paystack (card, bank transfer, USSD)
  CASH         // Physical cash recorded by bursar
  BANK_DEPOSIT // Manual bank deposit (teller receipt)
  POS_TERMINAL // Point of Sale card terminal
  BANK_TRANSFER // Direct electronic bank transfer
}

enum PaymentStatus {
  PENDING   // Paystack checkout opened, not yet confirmed
  SUCCESS   // Confirmed (webhook or manual)
  FAILED    // Paystack failure or cancelled
}

/// A fee type and amount for a given level/term (e.g. "Tuition — JSS1 — ₦25,000").
/// Admin defines these; they are referenced when generating invoices.
model FeeStructure {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String                          // "Tuition Fee", "PTA Levy", "Sports Fee"
  level        String?                         // "JSS1", "SS2" — null = all levels
  termId       String?  @map("term_id")        // null = one-time / annual fee
  academicYear String   @map("academic_year")
  amount       Float
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school       School        @relation(fields: [schoolId], references: [id])
  term         Term?         @relation(fields: [termId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([schoolId])
  @@index([academicYear])
  @@map("fee_structures")
}

/// An invoice issued to a student for a term (or part of a term).
/// Total = sum of all InvoiceItems. paidAmount updated on each Payment.
model Invoice {
  id           String        @id @default(uuid())
  schoolId     String        @map("school_id")
  studentId    String        @map("student_id")
  termId       String?       @map("term_id")
  academicYear String        @map("academic_year")
  totalAmount  Float         @map("total_amount")
  paidAmount   Float         @default(0) @map("paid_amount")
  status       InvoiceStatus @default(UNPAID)
  dueDate      DateTime?     @map("due_date")
  notes        String?
  createdById  String        @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  school     School        @relation(fields: [schoolId], references: [id])
  student    Student       @relation(fields: [studentId], references: [id])
  term       Term?         @relation(fields: [termId], references: [id])
  createdBy  User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items      InvoiceItem[]
  payments   Payment[]

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@map("invoices")
}

/// One line item on an invoice (e.g. Tuition ₦25,000, PTA ₦2,000).
model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String  @map("invoice_id")
  feeStructureId String? @map("fee_structure_id")  // null if manually added
  name           String                             // Copied at invoice time
  amount         Float

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

/// A payment made against an invoice — cash or Paystack.
model Payment {
  id           String        @id @default(uuid())
  schoolId     String        @map("school_id")
  invoiceId    String        @map("invoice_id")
  amount       Float
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  reference    String        @unique              // Paystack ref or bursar receipt no.
  paystackRef  String?       @map("paystack_ref") // Paystack transaction reference
  paidAt       DateTime?     @map("paid_at")
  recordedById String        @map("recorded_by_id")
  notes        String?
  metadata     Json?                              // Raw Paystack webhook payload
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  school     School  @relation(fields: [schoolId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([schoolId])
  @@index([reference])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 6 — Library Management
// ─────────────────────────────────────────────────────────────────────────────

enum LoanStatus {
  ACTIVE    // Currently borrowed — not yet due
  RETURNED  // Returned (on time or overdue, fine paid/waived)
  OVERDUE   // Past due date, not yet returned
}

/// A book in the school library catalogue.
/// totalCopies and availableCopies are kept in sync on every borrow/return.
model Book {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  title           String
  author          String
  isbn            String?  @unique
  category        String?                      // "Science", "Fiction", "Mathematics", "Reference"
  publisher       String?
  publishYear     Int?     @map("publish_year")
  totalCopies     Int      @default(1) @map("total_copies")
  availableCopies Int      @default(1) @map("available_copies")
  shelfLocation   String?  @map("shelf_location") // e.g. "A3", "Row 2 Shelf 4"
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school School     @relation(fields: [schoolId], references: [id])
  loans  BookLoan[]

  @@index([schoolId])
  @@index([title])
  @@index([isbn])
  @@map("books")
}

/// A record of one copy of a book being borrowed by a student or staff.
/// Fine = ₦50 per overdue day (applied on return).
model BookLoan {
  id           String     @id @default(uuid())
  schoolId     String     @map("school_id")
  bookId       String     @map("book_id")
  studentId    String?    @map("student_id")   // if borrowed by/for a student
  borrowerName String     @map("borrower_name") // Snapshot: "Amina Bello" (staff or student name)
  dueDate      DateTime   @map("due_date")
  returnedAt   DateTime?  @map("returned_at")
  status       LoanStatus @default(ACTIVE)
  fine         Float      @default(0)          // Naira — computed on return
  finePaid     Boolean    @default(false) @map("fine_paid")
  issuedById   String     @map("issued_by_id")
  returnedById String?    @map("returned_by_id")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  school      School   @relation(fields: [schoolId], references: [id])
  book        Book     @relation(fields: [bookId], references: [id])
  student     Student? @relation(fields: [studentId], references: [id])
  issuedBy    User     @relation("LoanIssuedBy", fields: [issuedById], references: [id])
  returnedBy  User?    @relation("LoanReturnedBy", fields: [returnedById], references: [id])

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
  @@index([status])
  @@map("book_loans")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 7 — Transport Management
// ─────────────────────────────────────────────────────────────────────────────

/// A school bus / vehicle.
model Bus {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String                       // e.g. "Bus A", "Yellow Bus 1"
  plateNumber  String   @map("plate_number") // e.g. "ABC-123-KN"
  capacity     Int                           // Max number of students
  driverName   String   @map("driver_name")
  driverPhone  String?  @map("driver_phone")
  assistantName String? @map("assistant_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school              School               @relation(fields: [schoolId], references: [id])
  routes              TransportRoute[]
  studentAssignments  StudentTransport[]

  @@unique([schoolId, plateNumber])
  @@index([schoolId])
  @@map("buses")
}

/// A named pickup/dropoff route served by one bus.
model TransportRoute {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  busId       String   @map("bus_id")
  name        String                       // e.g. "Tudun Wada Route", "GRA Morning"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school             School             @relation(fields: [schoolId], references: [id])
  bus                Bus                @relation(fields: [busId], references: [id])
  stops              RouteStop[]
  studentAssignments StudentTransport[]

  @@index([schoolId])
  @@index([busId])
  @@map("transport_routes")
}

/// An ordered stop on a route (e.g. stop 1 = "Market Junction").
model RouteStop {
  id          String @id @default(uuid())
  routeId     String @map("route_id")
  stopName    String @map("stop_name")
  stopOrder   Int    @map("stop_order") // 1, 2, 3…
  landmark    String?                   // Optional nearby landmark
  pickupTime  String? @map("pickup_time") // "06:45" — morning pickup time

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopOrder])
  @@index([routeId])
  @@map("route_stops")
}

/// Assignment of a student to a bus route (pickup and dropoff stop).
model StudentTransport {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  studentId    String   @map("student_id")
  busId        String   @map("bus_id")
  routeId      String   @map("route_id")
  pickupStop   String   @map("pickup_stop")   // Stop name for morning pickup
  dropoffStop  String   @map("dropoff_stop")  // Stop name for afternoon drop
  academicYear String   @map("academic_year")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id])
  student Student        @relation(fields: [studentId], references: [id])
  bus     Bus            @relation(fields: [busId], references: [id])
  route   TransportRoute @relation(fields: [routeId], references: [id])

  @@unique([studentId, academicYear])   // one assignment per student per year
  @@index([schoolId])
  @@index([busId])
  @@index([routeId])
  @@map("student_transport")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 10 — Academic Timetables & Weekly Schedules
// ─────────────────────────────────────────────────────────────────────────────

model Timetable {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  academicYear   String    @map("academic_year")
  termId         String?   @map("term_id")
  title          String    @default("Academic Master Timetable")
  periodsPerDay  Int       @default(8) @map("periods_per_day")
  periodDuration Int       @default(40) @map("period_duration")
  startTime      String    @default("08:00") @map("start_time")
  days           String    @default("MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY")
  breakAfter     Int       @default(4) @map("break_after")
  breakDuration  Int       @default(30) @map("break_duration")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  school  School            @relation(fields: [schoolId], references: [id])
  term    Term?             @relation(fields: [termId], references: [id])
  lessons TimetableLesson[]
  dutyAssignments TeacherDutyAssignment[]

  @@index([schoolId])
  @@map("timetables")
}

model TimetableLesson {
  id             String    @id @default(uuid())
  timetableId    String    @map("timetable_id")
  classSectionId String    @map("class_section_id")
  subjectId      String    @map("subject_id")
  teacherId      String?   @map("teacher_id")
  day            String    // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY
  periodNumber   Int       @map("period_number") // 1..8
  startTime      String    @map("start_time")    // e.g. "08:00 AM"
  endTime        String    @map("end_time")      // e.g. "08:40 AM"
  room           String?
  isDouble       Boolean   @default(false) @map("is_double")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  timetable    Timetable    @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User?        @relation("TimetableTeacher", fields: [teacherId], references: [id])
  substitutions TeacherSubstitution[]

  @@unique([timetableId, classSectionId, day, periodNumber])
  @@index([timetableId])
  @@index([classSectionId])
  @@index([teacherId])
  @@map("timetable_lessons")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 11 — School Clinic & Sick Bay Operations
// ─────────────────────────────────────────────────────────────────────────────

enum VisitDisposition {
  RESTING_IN_BAY
  RETURNED_TO_CLASS
  SENT_HOME
  REFERRED_TO_HOSPITAL
}

model ClinicVisit {
  id                     String           @id @default(uuid())
  schoolId               String           @map("school_id")
  studentId              String           @map("student_id")
  nurseId                String?          @map("nurse_id")
  visitDate              DateTime         @default(now()) @map("visit_date")
  complaint              String
  symptoms               String?
  temperature            Float?
  bloodPressure          String?          @map("blood_pressure")
  pulseRate              Int?             @map("pulse_rate")
  weight                 Float?
  diagnosis              String?
  treatmentGiven         String?          @map("treatment_given")
  disposition            VisitDisposition @default(RETURNED_TO_CLASS)
  parentNotified         Boolean          @default(false) @map("parent_notified")
  parentNotificationTime DateTime?        @map("parent_notification_time")
  referralHospital       String?          @map("referral_hospital")
  referralReason         String?          @map("referral_reason")
  doctorNotes            String?          @map("doctor_notes")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  school    School               @relation(fields: [schoolId], references: [id])
  student   Student              @relation(fields: [studentId], references: [id])
  nurse     User?                @relation("ClinicVisitLoggedBy", fields: [nurseId], references: [id])
  dispenses MedicationDispense[]

  @@index([schoolId])
  @@index([studentId])
  @@index([visitDate])
  @@map("clinic_visits")
}

model ClinicInventory {
  id             String               @id @default(uuid())
  schoolId       String               @map("school_id")
  itemCode       String               @unique @map("item_code")
  name           String
  category       String               @default("MEDICATION")
  dosageForm     String?              @map("dosage_form")
  unit           String               @default("Tablets")
  quantityOnHand Int                  @default(0) @map("quantity_on_hand")
  reorderLevel   Int                  @default(10) @map("reorder_level")
  expiryDate     DateTime?            @map("expiry_date")
  batchNumber    String?              @map("batch_number")
  locationRack   String?              @map("location_rack")
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  school    School             @relation(fields: [schoolId], references: [id])
  dispenses MedicationDispense[]

  @@index([schoolId])
  @@map("clinic_inventory")
}

model MedicationDispense {
  id          String           @id @default(uuid())
  schoolId    String           @map("school_id")
  visitId     String?          @map("visit_id")
  studentId   String           @map("student_id")
  inventoryId String           @map("inventory_id")
  nurseId     String?          @map("nurse_id")
  quantity    Int              @default(1)
  dosage      String?
  dispensedAt DateTime         @default(now()) @map("dispensed_at")

  school    School          @relation(fields: [schoolId], references: [id])
  visit     ClinicVisit?    @relation(fields: [visitId], references: [id])
  student   Student         @relation(fields: [studentId], references: [id])
  inventory ClinicInventory @relation(fields: [inventoryId], references: [id])
  nurse     User?           @relation("MedicationDispensedBy", fields: [nurseId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@map("medication_dispenses")
}

model ImmunizationRecord {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  studentId      String    @map("student_id")
  vaccineName    String    @map("vaccine_name")
  doseNumber     Int       @default(1) @map("dose_number")
  administeredAt DateTime  @map("administered_at")
  nextDueDate    DateTime? @map("next_due_date")
  provider       String?
  batchNumber    String?   @map("batch_number")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@map("immunization_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 12 — Faculty Duty Rosters & Substitutions
// ─────────────────────────────────────────────────────────────────────────────

enum DutyCategory {
  MORNING_ASSEMBLY
  CAMPUS_CORRIDOR
  DINING_HALL
  PREP_SUPERVISION
  EXAM_INVIGILATION
  SPORTS_GAMES
  GATE_DUTY
}

model TeacherDutyAssignment {
  id           String       @id @default(uuid())
  schoolId     String       @map("school_id")
  timetableId  String?      @map("timetable_id")
  teacherId    String       @map("teacher_id")
  category     DutyCategory
  day          String?      // MONDAY, TUESDAY, etc., or null for full-week duty
  periodNumber Int?         @map("period_number")
  weekNumber   Int          @default(1) @map("week_number") // 1..14
  academicYear String       @map("academic_year")
  termId       String?      @map("term_id")
  venue        String?
  instructions String?
  isCompleted  Boolean      @default(false) @map("is_completed")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id])
  teacher   User       @relation("TeacherDutyAssignments", fields: [teacherId], references: [id])
  timetable Timetable? @relation(fields: [timetableId], references: [id], onDelete: SetNull)

  @@index([schoolId, academicYear, weekNumber])
  @@index([teacherId])
  @@map("teacher_duty_assignments")
}

model TeacherSubstitution {
  id                  String   @id @default(uuid())
  schoolId            String   @map("school_id")
  lessonId            String   @map("lesson_id")
  absentTeacherId     String   @map("absent_teacher_id")
  substituteTeacherId String   @map("substitute_teacher_id")
  date                DateTime @db.Date
  reason              String?
  status              String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  school            School          @relation(fields: [schoolId], references: [id])
  lesson            TimetableLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  absentTeacher     User            @relation("AbsentTeacherSubstitutions", fields: [absentTeacherId], references: [id])
  substituteTeacher User            @relation("SubstituteTeacherAssignments", fields: [substituteTeacherId], references: [id])

  @@index([schoolId, date])
  @@index([lessonId])
  @@map("teacher_substitutions")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 13 — Bursary Financial Operations & Audit Logs
// ─────────────────────────────────────────────────────────────────────────────

model ReceiptSequence {
  id          String   @id @default(uuid())
  schoolId    String   @unique @map("school_id")
  prefix      String   @default("BFA-REC")
  currentYear Int      @default(2026) @map("current_year")
  lastNumber  Int      @default(0) @map("last_number")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@map("receipt_sequences")
}

model DailyCashDrawer {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  bursarId      String    @map("bursar_id")
  date          DateTime  @db.Date
  openingCash   Float     @default(0) @map("opening_cash")
  cashCollected Float     @default(0) @map("cash_collected")
  posCollected  Float     @default(0) @map("pos_collected")
  transferTotal Float     @default(0) @map("transfer_total")
  closingCash   Float?    @map("closing_cash")
  difference    Float?
  status        String    @default("OPEN") // OPEN, CLOSED, AUDITED
  closureNotes  String?   @map("closure_notes")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bursar User   @relation("BursarCashDrawers", fields: [bursarId], references: [id])
  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, bursarId, date])
  @@map("daily_cash_drawers")
}

model FinancialAuditLog {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  action     String   // RECEIPT_ISSUED, PAYMENT_RECORDED, DISCOUNT_GRANTED, DRAWER_CLOSED, PAYMENT_REVERSED
  studentId  String?  @map("student_id")
  invoiceId  String?  @map("invoice_id")
  amount     Float?
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])
  actor  User   @relation("FinancialAuditLogs", fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
  @@map("financial_audit_logs")
}

